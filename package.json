{
  "name": "kala",
  "version": "1.0.0",
  "description": "Pomodoro + pengingat deadline tugas kuliah dalam bentuk notch di atas layar Windows",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/engine.test.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "Kelompok",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kuliah.kala",
    "productName": "Kala",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kala"
    }
  }
}
